{
  "package": "press_selection",
  "purpose": "최종모델 선정근거·같은 특징 대안·결합 규칙·통합 비교·오경보 대응 시험(run.py). 검증: python analysis/package_contract.py --package analysis/press_selection",
  "outputs": [
    "same_feature_alternatives.csv",
    "combination_rules.csv",
    "fp_mitigation_v2.csv",
    "fp_mitigation_injection_v2.csv",
    "search_ledger.csv",
    "candidate_universe.csv",
    "nested_selection.csv",
    "paired_records.csv",
    "selection_evidence.csv",
    "unified_comparison.csv",
    "unified_comparison.md",
    "rule_transfer_injection_v2.csv"
  ],
  "manifests": {
    "manifest.json": {
      "groups": {
        "input_sha256": "data",
        "code_sha256": "auto",
        "dependencies_sha256": "auto",
        "outputs": "outputs"
      }
    }
  },
  "tolerance": 1e-09,
  "meta_keys": [
    "elapsed_s",
    "environment"
  ],
  "run_options": [],
  "commands": [
    "python analysis/press_selection/run.py"
  ],
  "tolerances": {
    "same_feature_alternatives.csv": {
      "row_auroc": 0.0001
    }
  },
  "tolerance_reasons": "같은 특징 대안의 행 AUROC: 동률 근처 점수의 순위가 기기마다 뒤바뀐다(리눅스 x86-64 실측 4.1e-7). 지도학습(HGB) 재실행 행은 --full에서만 다시 만들며 기기에 따라 TP가 ±1~3 달라질 수 있다"
}
